#!/usr/bin/env swift
// One command for a screenshot of one window, so a worker can look at what it
// built without a human at the screen (docs/hackathon/mvp-cd/PRODUCT.md → UI check).
//
//   scripts/shot out.png                       # the dev harness window (owner "dev-harness")
//   scripts/shot out.png --owner Finder        # any app, by process name
//   scripts/shot out.png --title "Dev Harness" # by window title (needs Screen Recording for other apps)
//   scripts/shot out.png --list                # print the on-screen windows and exit
//
// It finds the window with CoreGraphics and captures it with screencapture(1);
// the terminal that runs it needs Screen Recording. Exit 1 when no window
// matches, so a missing window is red, not an empty image.

import CoreGraphics
import Foundation

var arguments = Array(CommandLine.arguments.dropFirst())
guard let output = arguments.first else {
    FileHandle.standardError.write(Data("shot: usage: scripts/shot <out.png> [--owner <name>] [--title <text>] [--list]\n".utf8))
    exit(2)
}
arguments.removeFirst()

var owner: String? = "dev-harness"
var title: String?
var listOnly = false
var index = 0
while index < arguments.count {
    switch arguments[index] {
    case "--owner":
        owner = arguments.indices.contains(index + 1) ? arguments[index + 1] : nil
        index += 2
    case "--title":
        title = arguments.indices.contains(index + 1) ? arguments[index + 1] : nil
        owner = nil
        index += 2
    case "--list":
        listOnly = true
        index += 1
    default:
        FileHandle.standardError.write(Data("shot: unknown argument \(arguments[index])\n".utf8))
        exit(2)
    }
}

let options: CGWindowListOption = [.optionOnScreenOnly, .excludeDesktopElements]
guard let windows = CGWindowListCopyWindowInfo(options, kCGNullWindowID) as? [[String: Any]] else {
    FileHandle.standardError.write(Data("shot: could not list windows\n".utf8))
    exit(1)
}

struct Candidate {
    let id: CGWindowID
    let owner: String
    let title: String
    let layer: Int
    let area: Double
}

let candidates = windows.compactMap { info -> Candidate? in
    guard let id = info[kCGWindowNumber as String] as? CGWindowID else { return nil }
    let bounds = info[kCGWindowBounds as String] as? [String: Double] ?? [:]
    let area = (bounds["Width"] ?? 0) * (bounds["Height"] ?? 0)
    return Candidate(
        id: id,
        owner: info[kCGWindowOwnerName as String] as? String ?? "",
        title: info[kCGWindowName as String] as? String ?? "",
        layer: info[kCGWindowLayer as String] as? Int ?? 0,
        area: area)
}

if listOnly {
    for candidate in candidates where candidate.layer == 0 && candidate.area > 0 {
        print("\(candidate.id)\t\(candidate.owner)\t\(candidate.title)")
    }
    exit(0)
}

let matches = candidates.filter { candidate in
    guard candidate.layer == 0, candidate.area > 0 else { return false }
    if let owner, candidate.owner != owner { return false }
    if let title, !candidate.title.contains(title) { return false }
    return true
}

guard let target = matches.max(by: { $0.area < $1.area }) else {
    let wanted = [owner.map { "owner \"\($0)\"" }, title.map { "title containing \"\($0)\"" }].compactMap { $0 }.joined(separator: ", ")
    FileHandle.standardError.write(Data("shot: no on-screen window with \(wanted); try --list\n".utf8))
    exit(1)
}

let capture = Process()
capture.executableURL = URL(fileURLWithPath: "/usr/sbin/screencapture")
capture.arguments = ["-x", "-o", "-l", String(target.id), output]
do {
    try capture.run()
} catch {
    FileHandle.standardError.write(Data("shot: screencapture did not start: \(error)\n".utf8))
    exit(1)
}
capture.waitUntilExit()
guard capture.terminationStatus == 0, FileManager.default.fileExists(atPath: output) else {
    FileHandle.standardError.write(Data("shot: screencapture failed (status \(capture.terminationStatus))\n".utf8))
    exit(1)
}
print("shot: window \(target.id) of \(target.owner) \"\(target.title)\" → \(output)")
