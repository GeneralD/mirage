#!/usr/bin/env bash
# Regenerates the "Module Dependency Graph" section of docs/ARCHITECTURE.md from Package.swift and the
# `@Dependency` resolutions under Sources/. Run it from anywhere after adding, renaming or splitting a module,
# or after changing a liveValue registration or the AMBIENT list of scripts/check-dependency-keypaths.sh:
#
#   scripts/architecture-diagrams/regenerate
#
# module-edges.py takes the inventory, gen-diagrams.py draws the per-area diagrams (and fails when a module
# is in no diagram, an edge is drawn twice or not at all, or a DI registration is missing), and splice.py
# replaces the section with section-head.md (the Layer Overview, kept by hand) followed by the diagrams.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

swift package --package-path "$root" dump-package > "$work/dump-package.json"
python3 -I "$here/module-edges.py" "$root" "$work/dump-package.json" "$work/module-edges.json"
python3 -I "$here/gen-diagrams.py" "$work/module-edges.json" "$work/area-diagrams.md"
python3 -I "$here/splice.py" "$root/docs/ARCHITECTURE.md" "$here/section-head.md" "$work/area-diagrams.md"
